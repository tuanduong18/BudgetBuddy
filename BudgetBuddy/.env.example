# Frontend environment variables. Copy to BudgetBuddy/.env
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to app code, and it
# inlines them at BUILD time. Changing this value requires restarting the dev
# server (or rebuilding the APK) to take effect.
#
# Anything with this prefix is embedded in the shipped bundle and is readable
# by anyone with the app. Never put a secret here.

# Deployed backend:
EXPO_PUBLIC_API_BASE=https://budgetbuddy-api.onrender.com

# Local development against Docker Compose. Use your machine's LAN IP, not
# localhost, when testing on a physical phone - the phone resolves "localhost"
# to itself, not to your computer.
# EXPO_PUBLIC_API_BASE=http://192.168.1.100:5000
