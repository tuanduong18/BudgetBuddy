# Backend environment variables. Copy to backend/.env for local development.
# In production these are set in the Render dashboard, never committed.

# Signing keys. Generate real random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing JWT_SECRET_KEY invalidates every issued token and signs all users out.
JWT_SECRET_KEY=your-secret-key
SECRET_KEY=your-secret-key

# PostgreSQL connection string.
#
# IMPORTANT (Supabase): use the SESSION-mode pooler on port 5432:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Do NOT use port 6543 (transaction pooler). It multiplexes connections, so the
# LISTEN registration in app/socket_listener.py is dropped and real-time group
# updates silently stop working with no error.
#
# Do NOT use the direct db.<project-ref>.supabase.co host either: it is
# IPv6-only and unreachable from Render.
#
# Local Docker Compose uses a direct connection, which is fine:
#   postgresql://user:password@db:5432/budgetbuddy
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

DEBUG=True
